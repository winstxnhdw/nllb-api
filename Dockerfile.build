ARG USE_CUDA=

FROM python:latest AS model-builder

RUN pip install --no-cache-dir huggingface-hub
RUN python -c \
    "from huggingface_hub import snapshot_download; \
    snapshot_download('winstxnhdw/nllb-200-distilled-1.3B-ct2-int8')"


FROM python:latest AS python-builder

ARG USE_CUDA

WORKDIR /home/nonroot

ENV UV_MANAGED_PYTHON=1
ENV UV_PYTHON_INSTALL_DIR=/opt/python
ENV UV_LINK_MODE=copy
ENV UV_NO_CACHE=1
ENV UV_NO_DEV=1
ENV UV_LOCKED=1
ENV UV_NO_EDITABLE=1
ENV PYTHONOPTIMIZE=2

COPY --from=ghcr.io/astral-sh/uv:latest /uv /bin/
COPY pyproject.toml uv.lock ./
COPY client/pyproject.toml ./client/pyproject.toml
COPY language language

RUN uv sync --no-install-project ${USE_CUDA:+--extra cuda}

COPY . .

RUN uv sync ${USE_CUDA:+--extra cuda}
RUN find .venv -name '*.so*' -type f -exec strip --strip-unneeded {} +
RUN cd .venv && ln -s lib/python*/site-packages site-packages


FROM gcr.io/distroless/cc:nonroot

ARG USE_CUDA

ENV HOME=/home/nonroot
ENV PATH=$HOME/.venv/bin:$PATH
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV HF_HUB_OFFLINE=1
ENV TRANSFORMERS_NO_ADVISORY_WARNINGS=1
ENV USE_CUDA=${USE_CUDA:-False}
ENV LD_LIBRARY_PATH=$HOME/.venv/site-packages/nvidia/cublas/lib

COPY --from=model-builder  /root/.cache/huggingface $HOME/.cache/huggingface
COPY --from=python-builder /opt/python              /opt/python
COPY --from=python-builder /usr/lib/ssl             /usr/lib/ssl
COPY --from=python-builder $HOME/.venv              $HOME/.venv

USER nonroot
CMD ["nllb-api"]
